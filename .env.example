# Snowflake connection. The service user authenticates with a key pair, no password.
# Create the user, role, warehouse and database with setup/bootstrap.sql (run once as ACCOUNTADMIN).
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=CTRAG_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/ctrag/rsa_key.p8
SNOWFLAKE_ROLE=CTRAG_ROLE
SNOWFLAKE_WAREHOUSE=CTRAG_WH
SNOWFLAKE_DATABASE=CTRAG

# Cortex models. Availability depends on your Snowflake region.
CTRAG_EMBED_MODEL=snowflake-arctic-embed-m-v1.5
CTRAG_LLM_MODEL=claude-sonnet-5-5

# Number of chunks passed to the model per question.
CTRAG_TOP_K=8
